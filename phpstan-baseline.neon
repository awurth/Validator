parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method Awurth\\Validator\\Failure\\ValidationFailureCollectionInterface\:\:filter\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Twig/ValidatorExtension.php

		-
			message: '#^Call to an undefined method Awurth\\Validator\\Failure\\ValidationFailureCollectionInterface\:\:find\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Twig/ValidatorExtension.php

		-
			message: '#^Cannot call method getData\(\) on Awurth\\Validator\\Assertion\\DataCollectorAsserterInterface\|null\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Twig/ValidatorExtension.php

		-
			message: '#^Method Awurth\\Validator\\Twig\\ValidatorExtension\:\:findErrors\(\) should return Awurth\\Validator\\Failure\\ValidationFailureCollectionInterface but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/Twig/ValidatorExtension.php

		-
			message: '#^Method Awurth\\Validator\\Twig\\ValidatorExtension\:\:findFirst\(\) should return Awurth\\Validator\\Failure\\ValidationFailureInterface\|null but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/Twig/ValidatorExtension.php

		-
			message: '#^Parameter \#1 \$rules of class Awurth\\Validator\\Validation constructor expects Respect\\Validation\\Validator, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/ValidationFactory.php

		-
			message: '#^Parameter \#4 \$message of class Awurth\\Validator\\Validation constructor expects string\|null, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/ValidationFactory.php

		-
			message: '#^Parameter \#5 \$messages of class Awurth\\Validator\\Validation constructor expects array\<string, string\>, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/ValidationFactory.php

		-
			message: '#^Parameter \#6 \$globalMessages of class Awurth\\Validator\\Validation constructor expects array\<string, string\>, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/ValidationFactory.php

